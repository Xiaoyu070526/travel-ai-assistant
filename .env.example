# ============================================================
# AI 入境旅游搭子 —— 环境变量示例
# 复制本文件为 .env 并填入你自己的值；.env 已在 .gitignore 中，不会被提交。
# 切勿把真实 API Key 写进 Git 或任何文档。
# ============================================================

# DeepSeek Anthropic-compatible 接口地址
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 你的 API Key（二选一即可，ANTHROPIC_AUTH_TOKEN 优先）
ANTHROPIC_AUTH_TOKEN=your-api-key-here
# ANTHROPIC_API_KEY=your-api-key-here

# 模型名（默认 deepseek-flash，可覆盖）
ANTHROPIC_MODEL=deepseek-flash

# 请求超时（秒）与基础重试次数（均为可选）
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=3
